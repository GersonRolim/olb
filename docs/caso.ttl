ex:v_B_art1 a olb:Versao ; olb:versaoDe ex:LeiB_art1_cpt ; olb:inicioVigencia "2022-09-18"^^xsd:date ;
    olb:textoVerbatim "O art. 5º da Lei A passa a vigorar com a seguinte redação: “Art. 5º O registro terá validade de oito anos, contados da data de sua emissão.” (NR)" .
ex:v_B_art2 a olb:Versao ; olb:versaoDe ex:LeiB_art2_cpt ; olb:inicioVigencia "2022-09-18"^^xsd:date ;
    olb:textoVerbatim "Fica revogado o art. 7º da Lei A." .
