# ============================================================ LEI A: VERSÕES
ex:v_art5_cpt_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_cpt ;
    olb:inicioVigencia "2015-05-12"^^xsd:date ; olb:fimVigencia "2022-09-18"^^xsd:date ;
    olb:textoVerbatim "O registro terá validade de cinco anos, contados da data de sua emissão." .
ex:v_art5_cpt_2 a olb:Versao ; olb:versaoDe ex:LeiA_art5_cpt ;
    olb:inicioVigencia "2022-09-18"^^xsd:date ;
    olb:textoVerbatim "O registro terá validade de oito anos, contados da data de sua emissão." .
ex:v_art5_par1u_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_par1u ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "A renovação do registro dependerá de comprovação de:" .
ex:v_art5_inc1_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_par1u_inc1 ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "inscrição no cadastro nacional;" .
ex:v_art5_inc2_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_par1u_inc2 ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "regularidade das seguintes obrigações:" .
ex:v_art5_ali1_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_par1u_inc2_ali1 ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "tributárias;" .
ex:v_art5_ali2_1 a olb:Versao ; olb:versaoDe ex:LeiA_art5_par1u_inc2_ali2 ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "trabalhistas." .
ex:v_art6_cpt_1 a olb:Versao ; olb:versaoDe ex:LeiA_art6_cpt ; olb:inicioVigencia "2015-05-12"^^xsd:date ;
    olb:textoVerbatim "Compete ao órgão responsável manter o cadastro de que trata o art. 5º." .
ex:v_art7_cpt_1 a olb:Versao ; olb:versaoDe ex:LeiA_art7_cpt ;
    olb:inicioVigencia "2015-05-12"^^xsd:date ; olb:fimVigencia "2022-09-18"^^xsd:date ;
    olb:textoVerbatim "O registro poderá ser suspenso nos casos previstos em regulamento." .
ex:v_art7_cpt_2 a olb:Versao ; olb:versaoDe ex:LeiA_art7_cpt ; olb:inicioVigencia "2022-09-18"^^xsd:date ;
    olb:situacao olbv:revogado ; olb:textoVerbatim "(Revogado)." .

