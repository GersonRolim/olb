mh:AI5_1968 a olb:AtoInstitucional ; olb:rotulo "Ato Institucional nº 5, de 13 de dezembro de 1968" ;
    olb:urn "urn:lex:br:federal:ato.institucional:1968-12-13;5" ; olb:dataEpigrafe "1968-12-13"^^xsd:date ;
    olb:dataPublicacao "1968-12-13"^^xsd:date ; olb:inicioVigencia "1968-12-13"^^xsd:date ; olb:inicioVigenciaCalculado false ;
    rdfs:comment "Assinado por Costa e Silva. Doze artigos. Publicado no DOU de 13/12/1968; entra em vigor 'nesta data' (art. 12). Texto lido em planalto.gov.br."@pt .
mh:AI5_art1 a olb:Artigo ; olb:idFragmento "art1" ; olb:rotulo "Art. 1º" ; olb:temPaiImediato mh:AI5_1968 .
mh:AI5_art1_cpt a olb:Caput ; olb:idFragmento "art1_cpt" ; olb:temPaiImediato mh:AI5_art1 .
mh:AI5_art12 a olb:Artigo ; olb:idFragmento "art12" ; olb:rotulo "Art. 12" ; olb:temPaiImediato mh:AI5_1968 .
mh:AI5_art12_cpt a olb:Caput ; olb:idFragmento "art12_cpt" ; olb:temPaiImediato mh:AI5_art12 ; olb:clausulaRevogatoria olbv:clausulaGenerica .
mh:v_ai5_1 a olb:Versao ; olb:versaoDe mh:AI5_art1_cpt ; olb:inicioVigencia "1968-12-13"^^xsd:date ; olb:regimeOrtografico olbv:regimeFormulario1943 ;
    olb:textoVerbatim "São mantidas a Constituição de 24 de janeiro de 1967 e as Constituições estaduais, com as modificações constantes deste Ato Institucional." .
mh:v_ai5_12 a olb:Versao ; olb:versaoDe mh:AI5_art12_cpt ; olb:inicioVigencia "1968-12-13"^^xsd:date ; olb:regimeOrtografico olbv:regimeFormulario1943 ;
    olb:textoVerbatim "O presente Ato Institucional entra em vigor nesta data, revogadas as disposições em contrário." .

mh:EC11_1978 a olb:EmendaConstitucional ; olb:rotulo "Emenda Constitucional nº 11, de 13 de outubro de 1978" ;
    olb:urn "urn:lex:br:federal:emenda.constitucional:1978-10-13;11" ; olb:dataEpigrafe "1978-10-13"^^xsd:date ;
    olb:inicioVigencia "1979-01-01"^^xsd:date ; olb:inicioVigenciaCalculado false ;
    olb:pendenciaData "Publicação a conferir; vigência em 1/1/1979 segundo fontes secundárias" ;
