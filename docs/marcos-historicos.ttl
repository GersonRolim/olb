    olb:pendenciaData "Publicação e início de vigência a conferir" ;
    rdfs:comment "Fim do tráfico transatlântico. Antecede em 14 dias a Lei de Terras. Fonte secundária."@pt .
mh:Lei601_1850 a olb:LeiOrdinaria ; olb:rotulo "Lei nº 601, de 18 de setembro de 1850 (Lei de Terras)" ;
    olb:urn "urn:lex:br:federal:lei:1850-09-18;601" ; olb:dataEpigrafe "1850-09-18"^^xsd:date ;
    olb:pendenciaData "Publicação (20/9/1850, segundo fonte secundária) e início de vigência a conferir" ;
    rdfs:comment "Regulamentada só em 1854, pelo Decreto nº 1.318."@pt .
mh:Dec1318_1854 a olb:Decreto ; olb:rotulo "Decreto nº 1.318, de 30 de janeiro de 1854" ;
    olb:urn "urn:lex:br:federal:decreto:1854-01-30;1318" ; olb:dataEpigrafe "1854-01-30"^^xsd:date ;
    olb:fundamentoNaEdicao mh:Lei601_1850 ; olb:fundamentoLegalAtual mh:Lei601_1850 ;
    olb:pendenciaData "Publicação e início de vigência a conferir" ;
    rdfs:comment "Ementa: 'Manda executar a Lei nº 601, de 18 de Setembro de 1850'. Traz em anexo o Regulamento para a execução da lei (planalto.gov.br)."@pt .

mh:CCom_1850 a olb:LeiOrdinaria ; olb:rotulo "Lei nº 556, de 25 de junho de 1850 (Código Comercial)" ;
    olb:urn "urn:lex:br:federal:lei:1850-06-25;556" ; olb:dataEpigrafe "1850-06-25"^^xsd:date ;
    olb:pendenciaData "Publicação (1/7/1850, segundo base secundária) e início de vigência a conferir" ;
    rdfs:comment "Três partes. Parte Primeira revogada pelo Código Civil de 2002, art. 2.045. Parte Segunda (comércio marítimo) vigente. Parte Terceira revogada por norma anterior a 2002 (a conferir)."@pt .
mh:CCom_parte1 a olb:Parte ; olb:rotulo "Parte Primeira, Do Comércio em Geral" ; olb:agrupadorDaNorma mh:CCom_1850 .
mh:CCom_parte2 a olb:Parte ; olb:rotulo "Parte Segunda, Do Comércio Marítimo" ; olb:agrupadorDaNorma mh:CCom_1850 .
mh:CCom_parte3 a olb:Parte ; olb:rotulo "Parte Terceira, Das Quebras" ; olb:agrupadorDaNorma mh:CCom_1850 .

mh:Lei3353_1888 a olb:LeiOrdinaria ; olb:rotulo "Lei nº 3.353, de 13 de maio de 1888 (Lei Áurea)" ;
    olb:urn "urn:lex:br:federal:lei:1888-05-13;3353" ; olb:dataEpigrafe "1888-05-13"^^xsd:date ;
    olb:inicioVigencia "1888-05-13"^^xsd:date ; olb:inicioVigenciaCalculado false ;
    olb:pendenciaData "Publicação a conferir" ;
    rdfs:comment "Sancionada pela Princesa Imperial Regente. Dois artigos. Vigência 'desde a data desta Lei' (art. 1º). Texto lido em planalto.gov.br."@pt .
mh:Aurea_art1 a olb:Artigo ; olb:idFragmento "art1" ; olb:rotulo "Art. 1º" ; olb:temPaiImediato mh:Lei3353_1888 .
mh:Aurea_art1_cpt a olb:Caput ; olb:idFragmento "art1_cpt" ; olb:temPaiImediato mh:Aurea_art1 .
mh:Aurea_art2 a olb:Artigo ; olb:idFragmento "art2" ; olb:rotulo "Art. 2º" ; olb:temPaiImediato mh:Lei3353_1888 .
mh:Aurea_art2_cpt a olb:Caput ; olb:idFragmento "art2_cpt" ; olb:temPaiImediato mh:Aurea_art2 ; olb:clausulaRevogatoria olbv:clausulaGenerica .
mh:v_aurea1 a olb:Versao ; olb:versaoDe mh:Aurea_art1_cpt ; olb:inicioVigencia "1888-05-13"^^xsd:date ;
    olb:regimeOrtografico olbv:regimeEtimologico ;
    olb:textoVerbatim "E' declarada extincta, desde a data desta Lei, a escravidão no Brazil." ;
    olb:textoModernizado "É declarada extinta, desde a data desta Lei, a escravidão no Brasil." .
mh:v_aurea2 a olb:Versao ; olb:versaoDe mh:Aurea_art2_cpt ; olb:inicioVigencia "1888-05-13"^^xsd:date ;
    olb:regimeOrtografico olbv:regimeEtimologico ;
    olb:textoVerbatim "Revogam-se as disposições em contrario." .

mh:CC1916 a olb:LeiOrdinaria ; olb:rotulo "Lei nº 3.071, de 1º de janeiro de 1916 (Código Civil)" ;
    olb:urn "urn:lex:br:federal:lei:1916-01-01;3071" ; olb:dataEpigrafe "1916-01-01"^^xsd:date ;
